-- Objects are blueprints. Rules are promises an object keeps.

rule Greeter {
    beam greet() gives Text
}

object User follows Greeter {
    name: Text
    age: Int
    visits: Int = 0

    beam greet() gives Text {
        send "Hi, I am {name}"
    }

    beam visit() {
        visits = visits + 1
    }

    beam isAdult() gives Flag {
        send age >= 18
    }
}

launch {
    ada = User(name: "Ada", age: 36)
    show ada.greet()

    ada.visit()
    ada.visit()
    show "{ada.name} has visited {ada.visits} times"

    tobi = User("Tobi", 12)
    show "Is Tobi an adult? {tobi.isAdult()}"

    show ada
}
