-- Testing a web app without opening a browser

use web

server = web.open(8080)

server.get("/hello") {
    send "Hello from Laser Feet"
}

server.get("/square/:n") {
    n = int(request.params.n)
    send {number: n, square: n * n}
}

test "hello route answers" {
    expect server.visit("/hello").body is "Hello from Laser Feet"
}

test "squares come back as JSON" {
    expect server.visit("/square/7").json.square is 49
}

test "unknown pages are 404" {
    expect server.visit("/nope").status is 404
}
