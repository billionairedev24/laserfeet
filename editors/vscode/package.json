{
  "name": "laserfeet",
  "displayName": "Laser Feet",
  "description": "Live errors, autocomplete, hover types, go to definition, references, rename, outline, syntax highlighting and snippets for the Laser Feet programming language (.lf files).",
  "version": "0.2.0",
  "publisher": "laserfeet",
  "license": "SEE LICENSE IN README.md",
  "icon": "icons/extension.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/billionairedev24/laserfeet"
  },
  "homepage": "https://billionairedev24.github.io/laserfeet/",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters"
  ],
  "keywords": [
    "laserfeet",
    "laser feet",
    "lf"
  ],
  "contributes": {
    "languages": [
      {
        "id": "laserfeet",
        "aliases": [
          "Laser Feet",
          "laserfeet",
          "lf"
        ],
        "extensions": [
          ".lf"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/lf-file.svg",
          "dark": "./icons/lf-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "laserfeet",
        "scopeName": "source.laserfeet",
        "path": "./syntaxes/laserfeet.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "laserfeet",
        "path": "./snippets/laserfeet.json"
      }
    ],
    "configuration": {
      "title": "Laser Feet",
      "properties": {
        "laserfeet.path": {
          "type": "string",
          "default": "lf",
          "scope": "machine",
          "description": "The lf program used for live errors and autocomplete. Set this only if lf isn't on your PATH. For safety, only your user settings can change it, never a project's settings."
        }
      }
    },
    "configurationDefaults": {
      "[laserfeet]": {
        "editor.formatOnSave": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:laserfeet"
  ]
}
